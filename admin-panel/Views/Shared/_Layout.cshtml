
   @{
    var currentAction = "";
    if (ViewContext.RouteData.Values["action"] != null)
    {
        currentAction = ViewContext.RouteData.Values["action"].ToString();
    }

    var portalTitle = Session["PortalTitle"] as string;
    if (String.IsNullOrEmpty(portalTitle))
    {
        portalTitle = "Government Scholarship Portal";
    }

    var adminName = Session["AdminName"] as string;
    if (String.IsNullOrEmpty(adminName))
    {
        adminName = "Admin User";
    }

    var adminEmail = Session["AdminEmail"] as string;
    if (String.IsNullOrEmpty(adminEmail))
    {
        adminEmail = "admin@gov.in";
    }

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Admin Panel | Government Scholarship Portal</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Bootstrap 5 CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    
    <!-- Font Awesome 6 Icons via CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Local Fallback CSS references -->
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>

    <!-- Loading Spinner Overlay -->
    <div id="loader-overlay">
        <div class="text-center">
            <div class="gov-spinner mb-3"></div>
            <div class="text-dark fw-bold">Processing Secure Connection...</div>
            <div class="text-muted small">Government of India - Scholarship Portal</div>
        </div>
    </div>

    <!-- Main Wrapper -->
    <div id="wrapper">
        
        <!-- Sidebar Navigation -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <a href="@Url.Action("Dashboard", "Admin")">
                    <i class="fa-solid fa-building-columns text-warning"></i>
                    <span>SCHOLARSHIP PORTAL</span>
                </a>
            </div>
            
            <ul class="sidebar-menu">
                <li class="@(currentAction == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Dashboard", "Admin")">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="@(currentAction == "Scholarships" ? "active" : "")">
                    <a href="@Url.Action("Scholarships", "Admin")">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>Scholarships</span>
                    </a>
                </li>
                <li class="@(currentAction == "Students" ? "active" : "")">
                    <a href="@Url.Action("Students", "Admin")">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Students</span>
                    </a>
                </li>
                <li class="@(currentAction == "Applications" ? "active" : "")">
                    <a href="@Url.Action("Applications", "Admin")">
                        <i class="fa-solid fa-file-invoice"></i>
                        <span>Applications</span>
                        @* Note: Can put badge counter if desired *@
                    </a>
                </li>
                <li class="@(currentAction == "Reports" ? "active" : "")">
                    <a href="@Url.Action("Reports", "Admin")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Reports</span>
                    </a>
                </li>
                <li class="@(currentAction == "Notifications" ? "active" : "")">
                    <a href="@Url.Action("Notifications", "Admin")">
                        <i class="fa-solid fa-bullhorn"></i>
                        <span>Notifications</span>
                    </a>
                </li>
                <li class="@(currentAction == "Settings" ? "active" : "")">
                    <a href="@Url.Action("Settings", "Admin")">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Settings</span>
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <div>Phase 1 Prototype</div>
                <div>v1.0.0 (C# / MVC 5)</div>
            </div>
        </nav>

        <!-- Content Area -->
        <div id="content-wrapper">
            
            <!-- Sticky Header -->
            <header id="header">
                <div class="header-left">
                    <button id="sidebar-toggle" class="menu-toggle" title="Toggle Navigation Menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h5 class="m-0 d-none d-md-block text-primary fw-bold"><i class="fa-solid fa-shield-halved text-warning me-2"></i>Administration Panel</h5>
                </div>
                
                <div class="header-right">
                    <div class="portal-badge d-none d-lg-flex">
                        <i class="fa-solid fa-globe text-primary"></i>
                        <span>@portalTitle</span>
                    </div>
                    
                    <!-- Admin Profile Dropdown -->
                    <div class="dropdown">
                        <button class="admin-profile-btn dropdown-toggle" type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="admin-avatar">
                                @(adminName.Substring(0, 1).ToUpper())
                            </div>
                            <div class="text-start d-none d-sm-block">
                                <div class="fw-bold small" style="line-height: 1;">@adminName</div>
                                <span class="text-muted" style="font-size: 0.75rem;">Officer In-Charge</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2 p-2" aria-labelledby="profileDropdown" style="border-radius: 12px; font-size: 0.9rem;">
                            <li class="px-3 py-2 border-bottom mb-2">
                                <div class="fw-bold">@adminName</div>
                                <small class="text-muted">@adminEmail</small>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded" href="@Url.Action("Settings", "Admin")">
                                    <i class="fa-solid fa-user-gear me-2 text-muted"></i>Account Settings
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 px-3 rounded text-danger logout-link" href="@Url.Action("Logout", "Admin")">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i>Logout System
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Dynamic Content -->
            <main class="main-content">
                <!-- Success/Error Alert messages (TempData based) -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 10px; border-left: 5px solid var(--secondary-color) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-check fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 10px; border-left: 5px solid var(--danger-color) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-exclamation fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Official Footer -->
            <footer id="footer">
                <div class="container-fluid position-relative">
                    <div class="row align-items-center">
                        <div class="col-md-6 text-md-start mb-2 mb-md-0">
                            <strong>Government Scholarship Portal</strong> &copy; @DateTime.Now.Year. All Rights Reserved.
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="small text-muted">
                                Designed & Maintained by NIC / Ministry of Electronics & IT, Government of India.
                            </span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scroll to Top button -->
    <button id="scroll-top" title="Scroll back to top">
        <i class="fa-solid fa-chevron-up"></i>
    </button>

    <!-- Javascript dependencies (CDNs with local fallbacks) -->
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>window.jQuery || document.write('<script src="/Scripts/jquery-3.6.0.min.js"><\/script>')</script>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <script>if(typeof(bootstrap) === 'undefined') document.write('<script src="/Scripts/bootstrap.bundle.min.js"><\/script>')</script>

    <!-- ChartJS JS -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>if(typeof(Chart) === 'undefined') document.write('<script src="/Scripts/chart.min.js"><\/script>')</script>

    <!-- Custom Script -->
    <script src="~/Scripts/site.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
