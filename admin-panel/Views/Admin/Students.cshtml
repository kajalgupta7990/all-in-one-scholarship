@model List<GovernmentScholarshipPortal.Models.StudentViewModel>
@{
    ViewBag.Title = "Manage Students";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="m-0 text-primary">Manage Portal Students</h2>
        <p class="text-muted m-0">Review verified student profiles, check Aadhaar mappings, and monitor qualifications.</p>
    </div>
</div>

<!-- Students Grid Card -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="m-0 text-primary"><i class="fa-solid fa-user-graduate me-2"></i>Registered Students</h5>
        <div class="d-flex gap-2">
            <input type="text" id="studentSearch" class="form-control form-control-sm form-control-custom" placeholder="Search by name, email or course..." style="width: 300px;" />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive-custom border-0 shadow-none m-0">
            <table class="table table-custom align-middle" id="studentsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Student Name</th>
                        <th>Email Address</th>
                        <th>Enrolled Course</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th class="text-center" style="width: 150px;">Profile</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.Course</td>
                                <td><span class="badge bg-light text-dark">@item.Category</span></td>
                                <td>
                                    @if (item.VerificationStatus == "Verified")
                                    {
                                        <span class="badge-status bg-approved"><i class="fas fa-check-circle"></i> Verified</span>
                                    }
                                    else if (item.VerificationStatus == "Pending")
                                    {
                                        <span class="badge-status bg-pending"><i class="fas fa-clock"></i> Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status bg-rejected"><i class="fas fa-circle-xmark"></i> Rejected</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <!-- View Profile trigger - calls site.js AJAX action -->
                                        <button class="btn btn-sm btn-outline-primary view-student-profile btn-custom px-3 py-1" 
                                                data-id="@item.Id"
                                                title="View Student Profile Details">
                                            <i class="fa-regular fa-id-card me-1"></i> View Profile
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No registered student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- STUDENT PROFILE DRAWER / MODAL -->
<div class="modal fade" id="studentProfileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <!-- Modal Header -->
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title" id="profileModalLabel"><i class="fa-regular fa-address-card me-2"></i>Official Student Record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Modal Body -->
            <div class="modal-body modal-body-custom p-0">
                <!-- User card visual header -->
                <div class="p-4 bg-light border-bottom text-center">
                    <div class="admin-avatar mx-auto mb-2 shadow-sm" style="width: 60px; height: 60px; font-size: 1.5rem; background-color: var(--primary-light);">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                    <h5 id="profile-name" class="text-dark m-0">Student Full Name</h5>
                    <small id="profile-email" class="text-muted">student@email.com</small>
                </div>
                
                <!-- Detailed metadata grid -->
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <span class="text-muted small d-block">Academic Course</span>
                            <strong id="profile-course" class="text-dark">B.Tech Computer Science</strong>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Reservation Category</span>
                            <strong id="profile-category" class="text-dark">General</strong>
                        </div>
                        <div class="col-6 border-top pt-2">
                            <span class="text-muted small d-block">Aadhaar Mapping Status</span>
                            <strong id="profile-aadhaar" class="text-dark">1234-5678-9012</strong>
                        </div>
                        <div class="col-6 border-top pt-2">
                            <span class="text-muted small d-block">Academic GPA</span>
                            <strong id="profile-gpa" class="text-dark">8.90</strong>
                        </div>
                        <div class="col-12 border-top pt-2">
                            <span class="text-muted small d-block">Enrolled Institution</span>
                            <strong id="profile-institution" class="text-dark">Indian Institute of Technology, Delhi</strong>
                        </div>
                        <div class="col-12 border-top pt-2 d-flex align-items-center justify-content-between">
                            <span class="text-muted small">Verification Stamp</span>
                            <span id="profile-status" class="badge-status bg-approved">Verified</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Modal Footer -->
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Close Record</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Live Search Student Table
            $("#studentSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#studentsTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
