@{
    ViewBag.Title = "Reports & Analytics";
    var summaryReport = ViewBag.SummaryReport as IEnumerable<object>;

    // Safely get property value from dynamic/object data
    Func<object, string[], object> GetProperty = (obj, names) =>
    {
        if (obj == null) return null;

        var type = obj.GetType();

        foreach (var name in names)
        {
            var prop = type.GetProperty(name);

            if (prop != null)
                return prop.GetValue(obj);
        }

        return null;
    };
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h2 class="m-0 text-primary">System Reports & Analytics</h2>
        <p class="text-muted m-0">
            Consolidated analytics reports on applications status, budgets, and quota coverages.
        </p>
    </div>

    <div class="d-flex gap-2">
        <button onclick="window.print();" class="btn btn-outline-primary btn-custom">
            <i class="fa-solid fa-print me-2"></i>Print Report
        </button>

        <button id="exportCsv" class="btn btn-custom btn-custom-primary">
            <i class="fa-solid fa-file-csv me-2"></i>Export Summary (.CSV)
        </button>
    </div>
</div>

<!-- Print-Only Heading -->
<div class="d-none d-print-block mb-5 text-center">
    <h1 class="text-primary m-0">
        <i class="fa-solid fa-building-columns text-warning me-2"></i>
        Government Scholarship Portal
    </h1>

    <h3 class="text-muted mt-2">
        Official Allocation and Disbursement Audit Report
    </h3>

    <hr />

    <div class="text-start mt-3">
        <strong>Generated By:</strong> Secure Admin Portal<br />
        <strong>Audit Date:</strong> @DateTime.Now.ToString("F")
    </div>
</div>

<!-- Charts Grid -->
<div class="row g-4 mb-4">

    <!-- Pie Chart -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">

            <div class="card-header bg-white border-0 py-3 d-print-none">
                <h5 class="m-0 text-primary">
                    <i class="fa-solid fa-chart-pie me-2"></i>
                    Application Status Distribution
                </h5>
            </div>

            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="statusPieChart"></canvas>
                </div>
            </div>

        </div>
    </div>

    <!-- Bar Chart -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">

            <div class="card-header bg-white border-0 py-3 d-print-none">
                <h5 class="m-0 text-primary">
                    <i class="fa-solid fa-chart-column me-2"></i>
                    Budget Disbursement by Category (₹)
                </h5>
            </div>

            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="categoryBarChart"></canvas>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- Summary Report Table -->
<div class="card border-0 shadow-sm rounded-3 mb-4 page-break-before">

    <div class="card-header bg-white border-0 py-3">
        <h5 class="m-0 text-primary">
            <i class="fa-solid fa-table-list me-2"></i>
            Scholarship Allocation Summary
        </h5>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive-custom border-0 shadow-none m-0">

            <table class="table table-custom align-middle" id="summaryReportTable">

                <thead>
                    <tr>
                        <th>Scholarship Scheme</th>
                        <th>Quota</th>
                        <th>Grant Amount</th>
                        <th class="text-center">Total Applied</th>
                        <th class="text-center">Total Approved</th>
                        <th>Total Disbursed</th>
                    </tr>
                </thead>

                <tbody>

                    @if (summaryReport != null && summaryReport.Any())
                    {
                        foreach (var row in summaryReport)
                        {
                            var scholarshipName = GetProperty(
                                row,
                                new[] { "ScholarshipName", "SchemeName", "Name", "Scholarship" }
                            );

                            var category = GetProperty(
                                row,
                                new[] { "Category", "Quota", "ApplicableCategory" }
                            );

                            var amount = GetProperty(
                                row,
                                new[] { "Amount", "GrantAmount", "Grant", "ScholarshipAmount" }
                            );

                            var totalApplied = GetProperty(
                                row,
                                new[] { "TotalApplied", "Applied", "TotalApplications" }
                            );

                            var totalApproved = GetProperty(
                                row,
                                new[] { "TotalApproved", "Approved", "ApprovedApplications" }
                            );

                            var totalDisbursed = GetProperty(
                                row,
                                new[] { "TotalAmountDisbursed", "TotalDisbursed", "DisbursedAmount" }
                            );

                            <tr>

                                <td class="fw-bold text-dark text-wrap"
                                    style="max-width: 250px;">
                                    @(scholarshipName ?? "N/A")
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark px-3 py-1">
                                        @(category ?? "N/A")
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    ₹ @(amount ?? "0")
                                </td>

                                <td class="text-center fw-semibold">
                                    @(totalApplied ?? "0")
                                </td>

                                <td class="text-center fw-semibold text-success">
                                    @(totalApproved ?? "0")
                                </td>

                                <td class="fw-bold text-primary">
                                    ₹ @(totalDisbursed ?? "0")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">
                                No summary data available.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            // Application Status Data
            var statusLabels =
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StatusLabels));

            var statusData =
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StatusData));


            // Category Data
            var categoryLabels =
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CategoryLabels));

            var categoryData =
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.CategoryData));


            // 1. Pie Chart
            var pieElement = document.getElementById('statusPieChart');

            if (pieElement) {

                var ctxPie = pieElement.getContext('2d');

                new Chart(ctxPie, {

                    type: 'pie',

                    data: {
                        labels: statusLabels,

                        datasets: [{
                            data: statusData,

                            backgroundColor: [
                                '#1b7a5a',
                                '#f39c12',
                                '#c0392b'
                            ],

                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                position: 'bottom'
                            },

                            title: {
                                display: true,
                                text: 'Application Approvals State'
                            }
                        }
                    }

                });
            }


            // 2. Bar Chart
            var barElement = document.getElementById('categoryBarChart');

            if (barElement) {

                var ctxBar = barElement.getContext('2d');

                new Chart(ctxBar, {

                    type: 'bar',

                    data: {

                        labels: categoryLabels,

                        datasets: [{

                            label: 'Total Disbursed (₹)',

                            data: categoryData,

                            backgroundColor: '#1b5375',

                            hoverBackgroundColor: '#0f3d59',

                            borderRadius: 6,

                            borderWidth: 0
                        }]
                    },

                    options: {

                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            },

                            title: {
                                display: true,
                                text: 'Funds Released by Target Category Quotas'
                            }
                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                ticks: {

                                    callback: function (value) {
                                        return '₹' + value.toLocaleString();
                                    }

                                }

                            }

                        }

                    }

                });
            }


            // 3. Export CSV
            $('#exportCsv').on('click', function () {

                var csv = [];

                var rows =
                    document.querySelectorAll("#summaryReportTable tr");

                for (var i = 0; i < rows.length; i++) {

                    var row = [];

                    var cols =
                        rows[i].querySelectorAll("td, th");

                    for (var j = 0; j < cols.length; j++) {

                        var data =
                            cols[j].innerText
                                .replace(/[\n\r]+/g, '')
                                .trim();

                        data =
                            data.replace('₹ ', '')
                                .replace(/,/g, '');

                        row.push('"' + data + '"');
                    }

                    csv.push(row.join(","));
                }


                var csvFile =
                    new Blob(
                        [csv.join("\n")],
                        { type: "text/csv" }
                    );


                var downloadLink =
                    document.createElement("a");

                downloadLink.download =
                    "Scholarship_Allocation_Summary_" +
                    new Date().toISOString().slice(0, 10) +
                    ".csv";

                downloadLink.href =
                    window.URL.createObjectURL(csvFile);

                downloadLink.style.display = "none";

                document.body.appendChild(downloadLink);

                downloadLink.click();

                document.body.removeChild(downloadLink);

            });

        });

    </script>

}