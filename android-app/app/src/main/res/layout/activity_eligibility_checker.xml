<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColorLight"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtCheckHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_eligibility"
            android:textColor="@color/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/txtCheckSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_eligibility"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/txtCheckHeader"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Input forms -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/chkName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_full_name"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtCheckSub">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChkName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/chkIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_income"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/chkName">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChkIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/chkMarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_marks"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/chkIncome">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChkMarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Mock spinners/Dropdown inputs simplified via text fields -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/chkCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_category_selection"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/chkMarks">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChkCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_run_assessment"
            android:backgroundTint="@color/primaryColor"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/chkCategory" />

        <!-- Result Card placeholder -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardCheckResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/btnCheck">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#D1FAE5">
                
                <TextView
                    android:id="@+id/txtResultHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_matches"
                    android:textColor="#069669"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtResultBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/body_match_example"
                    android:textColor="#047857"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>