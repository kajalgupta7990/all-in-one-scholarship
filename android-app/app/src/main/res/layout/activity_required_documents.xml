<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColorLight"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_required_documents"
            android:textColor="@color/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/desc_upload_documents"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/info_allowed_files"
            android:textColor="@color/textColorSecondary"
            android:textSize="11sp"
            android:padding="12dp"
            android:background="@drawable/bg_info_box"
            android:layout_marginBottom="20dp" />

        <!-- Aadhaar Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_profile"
                        android:contentDescription="@string/label_aadhaar_card"
                        app:tint="@color/primaryColor" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_aadhaar_card"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desc_aadhaar_card"
                            android:textColor="@color/textColorSecondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAadhaarFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectAadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_aadhaar"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadAadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_aadhaar"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Income Certificate -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_scholarship"
                        android:contentDescription="@string/label_income_certificate"
                        app:tint="@color/accentColor" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_income_certificate"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desc_income_certificate"
                            android:textColor="@color/textColorSecondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvIncomeFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_income"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_income"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bonafide Certificate -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_scholarship"
                        android:contentDescription="@string/label_bonafide_certificate"
                        app:tint="@color/warningColor" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_bonafide_certificate"
                            android:textColor="@color/textColorPrimary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desc_bonafide_certificate"
                            android:textColor="@color/textColorSecondary"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBonafideFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectBonafide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_bonafide"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadBonafide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_bonafide"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Caste Certificate -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_caste_certificate"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_caste_certificate"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvCasteFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectCaste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_caste"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadCaste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_caste"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Domicile Certificate -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_domicile_certificate"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_domicile_certificate"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvDomicileFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectDomicile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_domicile"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadDomicile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_domicile"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bank Passbook -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_bank_passbook"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_bank_passbook"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvBankFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_bank"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_bank"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Previous Year Marksheet -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_marksheet"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_marksheet"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvMarksheetFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_file_selected"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSelectMarksheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_choose_marksheet"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnUploadMarksheet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_upload_marksheet"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>