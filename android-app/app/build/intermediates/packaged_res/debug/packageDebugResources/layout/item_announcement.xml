<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <TextView
                android:id="@+id/txtAnnTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Central Sector Deadline Extended"
                android:textColor="@color/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtAnnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aug 05"
                android:textColor="@color/textColorSecondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAnnDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registration window for Central Sector Scheme extended to September 15, 2026."
            android:textColor="@color/textColorSecondary"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
